# Existing Supabase project (keep your current values)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Exact public HTTPS origin, without path (required for indexing)
NEXT_PUBLIC_SITE_URL=
# Optional Search Console HTML verification token, not the complete tag
GOOGLE_SITE_VERIFICATION=

# Server only: listing assistant (never NEXT_PUBLIC_*)
OPENAI_API_KEY=
# Vision + Structured Outputs compatible model enabled on your account
OPENAI_LISTING_MODEL=

# Server only: administration. Never use NEXT_PUBLIC_ for these values.
SUPABASE_SECRET_KEY=
# Comma-separated exact Supabase auth user UUIDs allowed to administer the site
LEGOLFE_ADMIN_USER_IDS=
